{
  "name": "notain",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "build": "astro build && node scripts/modulepreload.mjs",
    "deploy": "wrangler pages deploy dist",
    "reset:dev": "node --env-file=.env scripts/reset-dev.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/solid-js": "^7.0.2",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vue": "^7.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.13.0",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.2.8",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "appwrite": "^28.1.0",
    "astro": "^7.3.7",
    "lucide-astro": "^0.556.0",
    "lucide-react": "^1.55.0",
    "lucide-svelte": "^1.0.1",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
