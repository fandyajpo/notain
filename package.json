{
  "name": "notain",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "astro dev --background",
    "dev:stop": "astro dev stop",
    "dev:status": "astro dev status",
    "dev:logs": "astro dev logs",
    "dev:pages": "npm run build && wrangler pages dev dist",
    "build": "astro build && node scripts/modulepreload.mjs && node scripts/sitemap.mjs && node scripts/csp-hashes.mjs",
    "deploy": "wrangler pages deploy dist",
    "reset:dev": "node --env-file=.env scripts/reset-dev.mjs",
    "indexes:ensure": "node --env-file=.env scripts/ensure-indexes.mjs",
    "migrate:invoice-status": "node --env-file=.env scripts/migrate-invoice-status.mjs",
    "migrate:customer-email": "node --env-file=.env scripts/migrate-customer-email.mjs",
    "payment-proof:ensure": "node --env-file=.env scripts/ensure-payment-proof.mjs",
    "stats:ensure": "node --env-file=.env scripts/ensure-stats.mjs",
    "catalog:ensure": "node --env-file=.env scripts/ensure-catalog.mjs",
    "audit:ensure": "node --env-file=.env scripts/ensure-audit.mjs",
    "support:ensure": "node --env-file=.env scripts/ensure-support.mjs",
    "payments:ensure": "node --env-file=.env scripts/ensure-payments.mjs",
    "orgs:ensure": "node --env-file=.env scripts/ensure-orgs.mjs",
    "org-columns:ensure": "node --env-file=.env scripts/ensure-org-columns.mjs",
    "business-type:ensure": "node --env-file=.env scripts/ensure-business-type.mjs",
    "migrate:org-identity": "node --env-file=.env scripts/migrate-org-identity.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke": "vp test run --config vitest.smoke.config.ts",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/solid-js": "^7.0.2",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vue": "^7.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.13.0",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.2.8",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "appwrite": "^28.1.0",
    "astro": "^7.3.7",
    "driver.js": "^1.9.0",
    "heic2any": "^0.0.4",
    "lucide-astro": "^0.556.0",
    "lucide-react": "^1.55.0",
    "lucide-svelte": "^1.0.1",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.17",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.149.0",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
