# Mailer service — copy to `mailer/.env` for local runs, never commit it.
# `.env` is git-ignored; `npm start` loads this file itself
# (`node --env-file-if-exists=.env`), and a real environment variable wins over
# it — which is how Docker and the Appwrite Function supply these values.
#
# These belong to the mailer process only. They are NOT Pages variables and must
# never reach the browser: the SMTP password is a full relay credential.

# --- SMTP relay -------------------------------------------------------------
# Gmail / Google Workspace: fill in ONLY these two lines and start the service.
#
#   SMTP_USER  the Google account that sends — anything@googlemail.com counts
#   SMTP_PASS  a 16-character App Password, NOT your normal password
#
# Google stopped accepting account passwords from apps, so an App Password is
# required (it needs 2-Step Verification turned on):
#   https://myaccount.google.com/apppasswords
# Paste it as Google shows it — the four groups' spaces are stripped for you.
SMTP_USER=you@gmail.com
SMTP_PASS=

# Anything below is optional for Google: an @gmail.com / @googlemail.com
# SMTP_USER already implies smtp.gmail.com on 465 with implicit TLS, and
# MAIL_FROM defaults to SMTP_USER (Google only allows that address or a verified
# "Send mail as" alias in From anyway).
#
# Set them for another relay — or to move to port 587, which switches STARTTLS
# on automatically. Leave SMTP_USER/SMTP_PASS both empty for a relay that trusts
# this host by IP; filling one without the other fails at boot.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURITY=tls
# MAIL_FROM=you@gmail.com

# --- product copy -----------------------------------------------------------
MAIL_APP_NAME=Notain
# Optional absolute URL for the header logo. Leave empty for a text-only header
# (an image a client cannot load is worse than no image).
# MAIL_LOGO_URL=https://notain.pages.dev/notain-remove-bg.png

# --- HTTP surface -----------------------------------------------------------
# Random, at least 32 characters (the server refuses to boot below that),
# identical to the MAIL_SERVICE_TOKEN Pages variable. Generate one with:
#   openssl rand -hex 32
MAIL_SERVICE_TOKEN=
# The port `/send` listens on, bound to 0.0.0.0. Hosts that inject $PORT
# (Cloud Run, Render, Fly) override this.
PORT=8080
