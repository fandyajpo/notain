# Appwrite backend — copy to `.env` and adjust.
#
# Astro only exposes variables prefixed with `PUBLIC_` to the browser, and the
# smoke test reads the same three names, so keep the prefix.
#
# The endpoint is REGION-SCOPED. An Appwrite Cloud project only answers on
# https://<region>.cloud.appwrite.io/v1. The global cloud.appwrite.io rejects
# it with 401 general_access_forbidden:
# "Project is not accessible in this region".
# Check the project's region in Appwrite Console → Settings.
PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1

# Appwrite Console → Overview → Project ID.
PUBLIC_APPWRITE_PROJECT_ID=project_id

# Appwrite Console → Databases → Database ID.
PUBLIC_APPWRITE_DATABASE_ID=database_id

# Logo API — OPTIONAL.
#
# Defaults to the path `/api/logo`, which is what the deployed site should
# use: a path keeps the build free of any particular domain and keeps every
# logo request on the same origin as the page (the Pages Function therefore
# never needs CORS). Override it only where a path has no meaning.
#
# `astro dev` does not run Pages Functions; `astro.config.mjs` forwards `/api`
# to the deployment instead. The smoke test sets this to the deployed URL
# because Node has no origin to resolve a path against.
# PUBLIC_LOGO_API=/api/logo

# Cloudflare Turnstile bot gate on sign-in/sign-up — OPTIONAL locally.
#
# Production reads the sitekey from the PUBLIC_TURNSTILE_SITE_KEY repository
# secret at build time (see .github/workflows/deploy.yml) — no key lives in
# the source. This override exists for local work only: `astro dev` leaves the
# gate off unless you point it at a widget whose allowed hostnames include
# `localhost`. The secret half (`TURNSTILE_SECRET_KEY`) lives as an encrypted
# Pages variable — never here.
# PUBLIC_TURNSTILE_SITE_KEY=

# DOKU SANDBOX checkout credentials — server-side only, never exposed to the browser.
#
# These are read by the Pages Functions in `functions/api/payments/*`, so they
# live as ENCRYPTED Pages variables (dashboard → Settings → Environment
# variables, or `wrangler pages secret put NAME`) — NOT in `.env`, which only
# feeds the client-side Vite build, and NOT in `wrangler.toml`, which is
# committed. Names must match exactly:
#
#   DOKU_CLIENT_ID   Merchant/Client-Id from the DOKU sandbox Back Office.
#                    Goes in the `Client-Id` header of every Checkout API call
#                    and must match what DOKU signs notifications with.
#   DOKU_SECRET_KEY  Back Office Secret Key — used to compute and verify the
#                    `HMACSHA256=` signatures on requests and notifications.
#   DOKU_API_KEY     Kept for DOKU APIs that use it (e.g. Snap Authorization);
#                    the hosted Checkout flow only needs the two above.
#
# SANDBOX ONLY: the endpoint is hardcoded to api-sandbox.doku.com in
# `src/core/billing/doku.ts`. Never put production credentials here — they
# would charge real money.