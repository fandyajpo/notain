# Appwrite backend — copy to `.env` and adjust.
#
# Astro only exposes variables prefixed with `PUBLIC_` to the browser, and the
# smoke test reads the same three names, so keep the prefix.
#
# The endpoint is REGION-SCOPED. An Appwrite Cloud project only answers on
# https://<region>.cloud.appwrite.io/v1. The global cloud.appwrite.io rejects
# it with 401 general_access_forbidden:
# "Project is not accessible in this region".
# Check the project's region in Appwrite Console → Settings.
PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1

# Appwrite Console → Overview → Project ID.
PUBLIC_APPWRITE_PROJECT_ID=project_id

# Appwrite Console → Databases → Database ID.
PUBLIC_APPWRITE_DATABASE_ID=database_id

# Logo API — OPTIONAL.
#
# Defaults to the path `/api/logo`, which is what the deployed site should
# use: a path keeps the build free of any particular domain and keeps every
# logo request on the same origin as the page (the Pages Function therefore
# never needs CORS). Override it only where a path has no meaning.
#
# `astro dev` does not run Pages Functions; `astro.config.mjs` forwards `/api`
# to the deployment instead. The smoke test sets this to the deployed URL
# because Node has no origin to resolve a path against.
# PUBLIC_LOGO_API=/api/logo
