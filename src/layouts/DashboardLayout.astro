---
import { Menu, PanelLeft, X } from 'lucide-react';
import { SignOutIsland } from '../components/react/auth/sign-out-island';
import { AdminNavGroup } from '../components/react/auth/admin-nav-link';
import { OrgSwitcherIsland } from '../components/react/orgs/org-switcher-island';
import { QuotaMeter } from '../components/react/dashboard/quota-meter';
import { ShortcutsIsland, ShortcutsTrigger } from '../components/react/ui/shortcuts';
import { NAV_GROUPS, UTILITIES_GROUP_LABEL, drawerStagger } from '../lib/nav';
import { navLinkClass } from '../lib/ui/classes';
import Layout from './Layout.astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const path = Astro.url.pathname;
const is_active = (href: string) => path === href || path.startsWith(`${href}/`);

// Section labels sit above each group in both surfaces; `sidebar-label` is the
// same class the brand and the item text use, so collapsing the rail to its
// icon column drops them too.
const GROUP_LABEL =
  'sidebar-label px-3 pb-1 pt-1 text-[11px] font-medium uppercase tracking-wider text-muted';
const stagger = drawerStagger();
---

<Layout title={title} description={description}>
  <div class="min-h-screen">
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 texture-dots [mask-image:linear-gradient(to_bottom,transparent,black_8%,black_92%,transparent)]"
    ></div>

    {/* Mobile & tablet: a compact brand bar with a hamburger; the nav itself
        lives in an animated drawer underneath (grid-rows 0fr→1fr). */}
    <header
      transition:persist="mobile-header"
      class="sticky top-0 z-40 border-b border-border bg-card/95 backdrop-blur supports-[backdrop-filter]:bg-card/80 lg:hidden"
    >
      <div class="flex h-14 items-center px-4">
        <a href="/dashboard" class="flex items-center gap-2 font-semibold tracking-tight">
          <img
            src="/notain-remove-bg.png"
            alt=""
            width={28}
            height={28}
            class="h-7 w-7 rounded-control"
          />
          <span>Notain</span>
        </a>
        <div class="ml-auto flex items-center gap-1">
          <button
            type="button"
            id="mobile-nav-toggle"
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
            aria-label="Buka menu navigasi"
            class="relative inline-flex h-9 w-9 items-center justify-center rounded-control text-foreground transition-colors hover:bg-accent-soft focus-ring"
          >
            <Menu size={18} className="nav-icon-menu transition-opacity" aria-hidden="true" />
            <X
              size={18}
              className="nav-icon-x absolute opacity-0 transition-opacity"
              aria-hidden="true"
            />
          </button>
          <SignOutIsland client:only="react" />
        </div>
      </div>
      <div
        id="mobile-nav-drawer"
        data-open="false"
        inert
        class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-smooth lg:hidden"
      >
        <div class="overflow-hidden">
          <nav
            class="flex flex-col gap-0.5 border-t border-border px-2 py-2"
            aria-label="Navigasi utama"
          >
            {/* Which workspace am I in — first thing in the drawer, before any
                page link, so the org context reads before the data does. */}
            <div class="mb-1">
              <OrgSwitcherIsland client:only="react" />
            </div>
            {NAV_GROUPS.map((group, groupIndex) => (
              <div class:list={['flex flex-col gap-0.5', groupIndex > 0 && 'mt-2']}>
                <p class={GROUP_LABEL}>{group.label}</p>
                {group.items.map(({ href, label, Icon }) => (
                  <a
                    href={href}
                    data-astro-prefetch
                    data-nav-link
                    aria-label={label}
                    title={label}
                    style={`--nav-i:${stagger.get(href) ?? 0}`}
                    class:list={[
                      'flex items-center gap-2.5 rounded-control px-3 py-2.5 text-sm transition-colors',
                      navLinkClass(is_active(href)),
                    ]}
                  >
                    <Icon size={16} aria-hidden="true" />
                    {label}
                  </a>
                ))}
              </div>
            ))}
            {/* The three islands sit in their own wrappers so each inherits the
                `--nav-i` its position in the drawer asks for. */}
            <div style={`--nav-i:${stagger.get('admin') ?? 0}`}>
              <AdminNavGroup client:only="react" />
            </div>
            {/* The free plan's invoice allowance — same cached query as the
                builder's meter, so the two numbers always agree. */}
            <div class="mt-2">
              <QuotaMeter client:only="react" />
            </div>
            <div class="mt-2">
              <p class={GROUP_LABEL}>{UTILITIES_GROUP_LABEL}</p>
              <div class="flex flex-col gap-0.5">
                <div style={`--nav-i:${stagger.get('shortcuts') ?? 0}`}>
                  <ShortcutsTrigger client:only="react" variant="drawer" />
                </div>
                <div style={`--nav-i:${stagger.get('sign-out') ?? 0}`}>
                  <SignOutIsland client:only="react" />
                </div>
              </div>
            </div>
          </nav>
        </div>
      </div>
    </header>

    {/* Desktop: a persistent sidebar beside the content. The aside stretches
        to the full row so its border runs the whole height; the sticky inner
        column is what actually stays in view while the page scrolls. The
        `html[data-sidebar]` attribute (set from localStorage before paint)
        collapses it to an icon rail to widen the view. */}
    <div class="app-shell lg:grid lg:min-h-screen lg:grid-cols-[15rem_1fr]">
      <aside
        id="app-sidebar"
        transition:persist="sidebar"
        class="hidden border-r border-border bg-card lg:block"
      >
        <div class="sticky top-0 flex h-screen flex-col p-4">
          <div class="flex items-center justify-between gap-2 px-2">
            <a
              href="/dashboard"
              aria-label="Notain"
              class="flex min-w-0 items-center gap-2 font-semibold tracking-tight"
            >
              <img
                src="/notain-remove-bg.png"
                alt=""
                width={28}
                height={28}
                class="h-7 w-7 shrink-0 rounded-control"
              />
              <span class="sidebar-label truncate">Notain</span>
            </a>
            <button
              type="button"
              id="sidebar-toggle"
              aria-expanded="true"
              aria-controls="app-sidebar"
              aria-label="Tutup sidebar"
              class="hidden shrink-0 rounded-control p-2 text-muted transition-colors hover:bg-background hover:text-foreground focus-ring lg:inline-flex"
            >
              <PanelLeft size={16} aria-hidden="true" />
            </button>
          </div>
          {/* The switcher sits between the brand and the nav: workspace first,
              pages second. Its `mt` and the nav's shrunken `mt` add back up to
              the rail's original rhythm. */}
          <div class="mt-4 px-2">
            <OrgSwitcherIsland client:only="react" />
          </div>
          <nav class="mt-6 flex flex-col gap-1" aria-label="Navigasi utama">
            {NAV_GROUPS.map((group, groupIndex) => (
              <div class:list={['flex flex-col gap-1', groupIndex > 0 && 'mt-2']}>
                <p class={GROUP_LABEL}>{group.label}</p>
                {group.items.map(({ href, label, Icon }) => (
                  <a
                    href={href}
                    data-astro-prefetch
                    data-nav-link
                    aria-label={label}
                    title={label}
                    class:list={[
                      'sidebar-link flex items-center gap-2 rounded-control px-3 py-2 text-sm transition-colors',
                      navLinkClass(is_active(href)),
                    ]}
                  >
                    <Icon size={16} aria-hidden="true" />
                    <span class="sidebar-label">{label}</span>
                  </a>
                ))}
              </div>
            ))}
            <AdminNavGroup client:only="react" />
          </nav>
          {/* Utilities sits at the foot of the column: Pintasan and Keluar stay
              reachable without scrolling and never compete with the nav for
              attention, and the whole block collapses to icons with the rail. */}
          {/* The free plan's invoice allowance, above the utilities so it is
              always visible without competing with the nav. The whole block
              carries `sidebar-label`, so the collapsed rail drops it too. */}
          <div class="mt-4 px-2">
            <QuotaMeter client:only="react" />
          </div>
          <div class="sidebar-foot mt-auto pt-4">
            <p class={GROUP_LABEL}>{UTILITIES_GROUP_LABEL}</p>
            <div class="flex flex-col gap-1">
              <ShortcutsTrigger client:only="react" variant="sidebar" />
              <SignOutIsland client:only="react" />
            </div>
          </div>
        </div>
      </aside>

      <main
        id="konten"
        tabindex="-1"
        class:list={[
          'app-main mx-auto w-full px-4 py-8 sm:px-6',
          // The 5xl/6xl caps keep prose and cards at a readable measure on
          // normal screens, but on wide desktops they left a dead gutter: at
          // 1440 the 1024px cap sat inside a ~1177px column, wasting ~150px.
          // `xl:` reopens the cap only where there is room to spare, so narrow
          // and medium widths render byte-identical and only wide desktops
          // use the extra space (the closed-rail rule below already lifts the
          // cap entirely, which is the precedent for this).
          wide ? 'max-w-6xl 2xl:max-w-7xl' : 'max-w-5xl xl:max-w-7xl',
        ]}
      >
        <slot />
      </main>

      {/* Mounts the shared pintasan dialog + the global `?` hotkey once. */}
      <ShortcutsIsland client:only="react" />
    </div>
  </div>
</Layout>

<script>
  import { NAV_ACTIVE_CLASS, NAV_IDLE_CLASS } from '../lib/ui/classes';

  // The sidebar and mobile header are `transition:persist`, so their SSR'd
  // active state freezes on whatever page was loaded first. Re-point it at the
  // live URL after every ClientRouter swap (and once on first paint). The
  // toggled tokens come from the same constants the SSR class lists use.
  const activeTokens = NAV_ACTIVE_CLASS.split(/\s+/);
  const idleTokens = NAV_IDLE_CLASS.split(/\s+/);

  function syncNav() {
    const path = window.location.pathname;
    const links = document.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]');
    for (const link of links) {
      const href = link.getAttribute('href') ?? '';
      const active = path === href || path.startsWith(`${href}/`);
      for (const token of activeTokens) link.classList.toggle(token, active);
      for (const token of idleTokens) link.classList.toggle(token, !active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    }
  }

  document.addEventListener('astro:page-load', syncNav);

  // --- Mobile nav drawer -------------------------------------------------
  const drawer = document.getElementById('mobile-nav-drawer');
  const navToggle = document.getElementById('mobile-nav-toggle');
  const mobileHeader = navToggle?.closest('header');

  function setNavOpen(open: boolean) {
    if (!drawer || !navToggle) return;
    drawer.dataset.open = String(open);
    // `inert` keeps the collapsed drawer out of the tab order and hit-testing.
    drawer.toggleAttribute('inert', !open);
    navToggle.setAttribute('aria-expanded', String(open));
    navToggle.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
    mobileHeader?.toggleAttribute('data-nav-open', open);
  }

  navToggle?.addEventListener('click', () => {
    setNavOpen(drawer?.dataset.open !== 'true');
  });

  // Picking any link (nav item or admin) closes the drawer.
  drawer?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setNavOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer?.dataset.open === 'true') {
      setNavOpen(false);
      navToggle?.focus();
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (drawer?.dataset.open !== 'true' || !mobileHeader) return;
    if (!mobileHeader.contains(event.target as Node)) setNavOpen(false);
  });

  // Growing past the sidebar breakpoint hides the header; reset so the drawer
  // does not reappear still-open when the viewport shrinks back.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024 && drawer?.dataset.open === 'true') setNavOpen(false);
  });

  // --- Desktop sidebar collapse ------------------------------------------
  const SIDEBAR_KEY = 'notain.sidebar';
  const sidebarToggle = document.getElementById('sidebar-toggle');

  function applySidebar(open: boolean) {
    document.documentElement.dataset.sidebar = open ? 'open' : 'closed';
    if (sidebarToggle) {
      sidebarToggle.setAttribute('aria-expanded', String(open));
      sidebarToggle.setAttribute('aria-label', open ? 'Tutup sidebar' : 'Buka sidebar');
    }
  }

  // A tiny inline script in the head applies `closed` before first paint;
  // this pass wires the toggle and normalises anything else.
  applySidebar(localStorage.getItem(SIDEBAR_KEY) !== 'closed');

  // The ClientRouter's swap replaces every `<html>` attribute with the
  // incoming document's (keep-list is only `data-astro-transition*`), so
  // `data-sidebar` is dropped on every soft navigation and the rail snaps
  // open. The head's inline restore does not re-run (scripts are deduped by
  // content) and this module executes once per session — so re-apply the
  // preference after each swap, before the new page paints.
  document.addEventListener('astro:after-swap', () => {
    applySidebar(localStorage.getItem(SIDEBAR_KEY) !== 'closed');
  });

  sidebarToggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.sidebar === 'closed';
    applySidebar(next);
    try {
      localStorage.setItem(SIDEBAR_KEY, next ? 'open' : 'closed');
    } catch {
      /* private mode — session-only preference */
    }
  });
</script>

<style is:global>
  /* The app's mobile header (brand bar + drawer) is taller than the landing's
     4rem header, so in-page anchors and tour spotlights need a larger offset
     on app pages only. */
  html {
    scroll-padding-top: 7rem;
  }

  /* --- Mobile nav drawer ------------------------------------------------ */
  #mobile-nav-drawer[data-open='true'] {
    grid-template-rows: 1fr;
  }
  #mobile-nav-drawer a {
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  #mobile-nav-drawer[data-open='false'] a {
    opacity: 0;
    transform: translateY(-4px);
  }
  /* Staggered entrance so the list cascades in instead of popping as a block.
     The index rides on each row as `--nav-i`, set in the markup from the
     drawer's flat order — a plain `nth-child` chain cannot count across the
     section wrappers the grouped menu is built from. */
  #mobile-nav-drawer[data-open='true'] a {
    transition-delay: calc(var(--nav-i, 0) * 0.04s);
  }
  #mobile-nav-toggle .nav-icon-menu,
  #mobile-nav-toggle .nav-icon-x {
    transition: opacity 0.2s ease;
  }
  header[data-nav-open='true'] #mobile-nav-toggle .nav-icon-menu {
    opacity: 0;
  }
  header[data-nav-open='true'] #mobile-nav-toggle .nav-icon-x {
    opacity: 1;
  }

  /* --- Desktop sidebar collapse ----------------------------------------- */
  @media (min-width: 1024px) {
    .app-shell {
      transition: grid-template-columns 0.3s var(--ease-smooth);
    }
  }
  html[data-sidebar='closed'] .app-shell {
    grid-template-columns: 4.5rem 1fr;
  }
  html[data-sidebar='closed'] .sidebar-label {
    display: none;
  }
  html[data-sidebar='closed'] .sidebar-link,
  html[data-sidebar='closed'] aside nav a {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
  }
  html[data-sidebar='closed'] .sidebar-foot button {
    width: 100%;
    justify-content: center;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }
  html[data-sidebar='closed'] .app-main {
    max-width: none;
  }
  #sidebar-toggle svg {
    transition: transform 0.3s var(--ease-smooth);
  }
  html[data-sidebar='closed'] #sidebar-toggle svg {
    transform: rotate(180deg);
  }
</style>
