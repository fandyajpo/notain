---
import Layout from './Layout.astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <!-- Same shell as the landing: dot texture, sticky marketing header, and the
       shared footer — but the static Astro twins, not the React islands. These
       pages carry no state or data, so they should not ship a React runtime.
       `anchorPrefix="/"` so footer links point at the homepage anchors instead
       of this page. -->
  <div class="min-h-screen overflow-x-clip">
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 texture-dots [mask-image:linear-gradient(to_bottom,transparent,black_8%,black_92%,transparent)]"
    ></div>

    <SiteHeader anchorPrefix="/" />

    <main id="konten" tabindex="-1" class="mx-auto w-full max-w-3xl px-5 py-16 sm:px-8">
      <slot />
    </main>

    <SiteFooter anchorPrefix="/" />
  </div>
</Layout>
