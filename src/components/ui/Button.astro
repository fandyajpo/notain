---
import type { HTMLAttributes } from 'astro/types';
import { LoaderCircle } from 'lucide-astro';
import { CONTROL_HEIGHT } from '../../lib/ui/classes';

type Variant = 'primary' | 'secondary' | 'ghost' | 'danger';
type Size = 'sm' | 'md' | 'lg';

interface Props extends HTMLAttributes<'button'> {
  variant?: Variant;
  size?: Size;
  href?: string;
  loading?: boolean;
  full?: boolean;
  target?: string;
  rel?: string;
  'data-modal-open'?: boolean | string;
  'data-modal-close'?: boolean | string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  loading = false,
  full = false,
  class: className,
  disabled = false,
  type = 'button',
  ...rest
} = Astro.props;

const base =
  'inline-flex select-none items-center justify-center gap-2 rounded-control font-medium whitespace-nowrap transition-colors focus-ring';

const variants: Record<Variant, string> = {
  primary: 'bg-accent text-accent-foreground hover:bg-accent/90 active:bg-accent/80',
  secondary: 'border border-border bg-card text-foreground shadow-card hover:bg-background',
  ghost: 'text-foreground hover:bg-border/60',
  danger: 'bg-danger text-danger-foreground hover:bg-danger/90 active:bg-danger/80',
};

/** Shared `CONTROL_HEIGHT` scale, same as the React `Button`: each size lines
 * up with the input/select of the same name (sm h-10, md h-11, lg h-12). */
const sizes: Record<Size, string> = {
  sm: `${CONTROL_HEIGHT.sm} px-3.5 text-sm`,
  md: `${CONTROL_HEIGHT.md} px-4 text-sm`,
  lg: `${CONTROL_HEIGHT.lg} px-5 text-base`,
};

const state = [disabled || loading ? 'opacity-50' : '', full ? 'w-full' : '', className ?? '']
  .filter(Boolean)
  .join(' ');

const classes = [base, variants[variant], sizes[size], state].filter(Boolean).join(' ');
---

{href !== undefined ? (
  <a
    href={href}
    class={classes}
    aria-disabled={disabled ? 'true' : undefined}
    {...(rest as HTMLAttributes<'a'>)}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={classes}
    disabled={disabled || loading}
    aria-busy={loading ? 'true' : undefined}
    {...rest}
  >
    {loading && <LoaderCircle size={16} class="animate-spin" aria-hidden="true" />}
    <slot />
  </button>
)}
