---
import type { HTMLAttributes, SvgComponent } from 'astro/types';
import { Inbox } from 'lucide-astro';

interface Props extends HTMLAttributes<'div'> {
  title: string;
  description?: string;
  icon?: SvgComponent;
}

const { title, description, icon: Icon = Inbox, class: className, ...rest } = Astro.props;
---

<div
  class={[
    'flex flex-col items-center justify-center gap-3 rounded-card border border-dashed border-border bg-card px-6 py-12 text-center',
    className ?? '',
  ]
    .filter(Boolean)
    .join(' ')}
  {...rest}
>
  <span
    class="flex size-12 items-center justify-center rounded-full bg-background text-muted"
    aria-hidden="true"
  >
    <Icon width={22} height={22} />
  </span>

  <h3 class="text-base font-semibold">{title}</h3>

  {description && <p class="max-w-sm text-sm text-muted">{description}</p>}

  <div class="mt-1">
    <slot />
  </div>
</div>
