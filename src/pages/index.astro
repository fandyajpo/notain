---
import Layout from '../layouts/Layout.astro';
import { LandingTop } from '../components/react/landing/landing-top';
import { LandingRest } from '../components/react/landing/landing-rest';
import { LandingFooter } from '../components/react/landing/landing-footer';
import { SITE_NAME, SITE_URL, SOCIAL_IMAGE } from '../lib/seo';

// Structured data lives on the home page only: it describes the site and the
// publisher, not this one screen. Deliberately no SearchAction: there is no
// site search to promise. Built from the same constants as the meta tags so
// the two can never name a different origin or logo.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
    {
      '@type': 'Organization',
      name: SITE_NAME,
      url: SITE_URL,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}${SOCIAL_IMAGE}`, width: 500, height: 500 },
    },
  ],
};
---

<Layout
  title="Notain | Urus Invoice Lebih Rapi. Fokus Kembangkan Usaha."
  description="Buat invoice profesional, kelola pelanggan, dan simpan dokumen tagihan dalam satu platform yang praktis. Gratis untuk UMKM & freelancer, PDF A4 siap dikirim lewat WhatsApp."
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
  />
  <!-- Three islands, not one: the top hydrates now because the header and
       progress bar react to scroll immediately, while the sections and the
       footer mount only as they approach the viewport (`client:visible`),
       keeping their chunks off the first load. The shared wrapper and the
       dot texture are plain HTML so all three paint before any JS runs. -->
  <div class="min-h-screen overflow-x-clip">
    <!-- Page-wide dot texture; fixed so content slides over it. -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 texture-dots [mask-image:linear-gradient(to_bottom,transparent,black_8%,black_92%,transparent)]"
    ></div>

    <LandingTop client:load>
      <LandingRest client:visible />
    </LandingTop>

    <LandingFooter client:visible />
  </div>
</Layout>
