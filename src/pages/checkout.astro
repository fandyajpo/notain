---
import Layout from '../layouts/Layout.astro';
import { CheckoutApp } from '../components/react/checkout/checkout-app';
---

<Layout
  title="Checkout | Notain"
  description="Selesaikan langganan Notain Pro atau Business lewat pembayaran DOKU."
>
  <main
    id="konten"
    tabindex="-1"
    class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-5 py-12"
  >
    <a href="/" class="mb-8 flex items-center justify-center gap-2 font-semibold tracking-tight">
      <img
        src="/notain-remove-bg.png"
        alt=""
        width={32}
        height={32}
        class="size-8 rounded-control"
      />
      Notain
    </a>

    <CheckoutApp client:only="react" />
  </main>
</Layout>
