---
import ContentPage from '../layouts/ContentPage.astro';
import { SupportForm } from '../components/react/support/support-form';
import { Notice } from '../components/react/ui/notice';
---

<ContentPage
  title="Hubungi Notain"
  description="Ada pertanyaan atau butuh bantuan? Kirim pesan ke tim Notain."
>
  <p class="text-eyebrow uppercase text-muted">Kontak</p>
  <h1 class="text-title">Hubungi kami</h1>
  <p class="mt-3 text-base text-muted">
    Ada pertanyaan soal fitur atau akun? Tulis pesan di bawah. Kami akan membalas lewat email dalam 1 sampai 2 hari kerja.
  </p>

  <div class="mt-6">
    <Notice variant="accent">
      Untuk pertanyaan cepat, email langsung ke{' '}
      <a
        href="mailto:notaindevs@gmail.com"
        class="font-medium text-foreground underline underline-offset-2"
      >
        notaindevs@gmail.com
      </a>
      .
    </Notice>
  </div>

  <div class="mt-8 rounded-card border border-border bg-card p-5 shadow-card sm:p-6">
    <SupportForm source="contact" client:visible />
  </div>
</ContentPage>
