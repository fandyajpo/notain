---
import Layout from '../layouts/Layout.astro';
import { PricingTop } from '../components/react/landing/pricing-top';
import { PricingPlans } from '../components/react/landing/pricing-plans';
import { FinaleCta } from '../components/react/landing/finale-cta';
import { SiteFooter } from '../components/react/landing/site-footer';
---

<Layout
  title="Harga Notain | Paket Free, Pro & Business"
  description="Pakai fitur dasar Notain gratis selamanya, termasuk template bawaan dan template buatan sendiri. Lihat harga Pro untuk membuat nota lebih banyak. Business sedang disiapkan."
>
  <!-- Three islands, not one — the same split the landing page uses. The price
       page is the same sheet of paper as the landing (`bg-paper`): the two are
       one document, not two templates. -->
  <div class="min-h-screen overflow-x-clip bg-paper text-ink">
    <PricingTop client:load>
      <PricingPlans client:visible />
      <FinaleCta client:visible />
    </PricingTop>

    <SiteFooter anchorPrefix="/" client:visible />
  </div>
</Layout>
