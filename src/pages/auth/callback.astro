---
import Layout from '../../layouts/Layout.astro';
import { OAuthCallback } from '../../components/react/auth/oauth-callback';
---

<Layout
  title="Menyelesaikan masuk | Notain"
  description="Menyelesaikan proses masuk dengan Google atau Discord."
>
  <main
    id="konten"
    tabindex="-1"
    class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-5 py-12"
  >
    <a href="/" class="mb-8 flex items-center justify-center gap-2 font-semibold tracking-tight">
      <img
        src="/notain-remove-bg.png"
        alt=""
        width={32}
        height={32}
        class="size-8 rounded-control"
      />
      Notain
    </a>

    <div class="rounded-card border border-border bg-card p-6 shadow-card sm:p-8">
      <OAuthCallback client:only="react" />
    </div>
  </main>
</Layout>
