---
import Layout from '../layouts/Layout.astro';
import { AuthPage } from '../components/react/auth/auth-page';
---

<Layout
  title="Lupa password | Notain"
  description="Minta tautan reset password untuk akun Notain kamu."
>
  <main class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-5 py-12">
    <a href="/" class="mb-8 flex items-center justify-center gap-2 font-semibold tracking-tight">
      <img
        src="/notain-remove-bg.png"
        alt=""
        width={32}
        height={32}
        class="size-8 rounded-control"
      />
      Notain
    </a>

    <div class="rounded-card border border-border bg-card p-6 shadow-card sm:p-8">
      <h1 class="text-title">Lupa password?</h1>
      <p class="mt-2 text-sm text-muted">
        Masukkan email akun kamu. Kami kirim tautan untuk ganti kata sandi.
      </p>

      <div class="mt-6">
        <AuthPage mode="forgot-password" client:only="react" />
      </div>
    </div>
  </main>
</Layout>
